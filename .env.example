# Stellar Dev Dashboard - Local Docker Compose Developer Bootstrap Environment

# Application environment (development | production)
NODE_ENV=development

# Web Frontend Port (5173 for local dev, 8080 for production container)
WEB_PORT=5173

# Backend API Configuration
PORT=4000
API_PORT=4000
VITE_API_URL=http://localhost:4000

# Redis Cache & Broker Configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
