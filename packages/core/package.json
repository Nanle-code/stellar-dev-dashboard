{
  "name": "@stellar-dev-dashboard/core",
  "version": "0.1.0",
  "description": "Platform-agnostic Stellar core logic shared between web and mobile apps",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "horizon",
    "soroban",
    "shared"
  ],
  "author": "Stellar Dev Dashboard Team",
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "globals": "^17.6.0"
  },
  "engines": {
    "node": ">=22 <27"
  },
  "publishConfig": {
    "access": "public"
  }
}